# Copy to .env and adjust. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Paths (defaults are relative to the repository root)
# ---------------------------------------------------------------------------
# OER_PATH_DATA=data
# OER_PATH_OUTPUTS=outputs

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# Pin a specific Companies House snapshot instead of resolving the latest.
# Set this when reproducing a published figure — the snapshots are mutable and
# a result is only reproducible against a named date.
# OER_SOURCE_SNAPSHOT_DATE=2026-08-04

# ---------------------------------------------------------------------------
# Matching thresholds
# ---------------------------------------------------------------------------
# Pairs at or above auto_accept become graph edges; below auto_reject are
# discarded; the band between is what the LLM adjudicator (or a human queue)
# sees. See docs/evaluation.md for the precision/recall curve these come from.
# OER_MATCH_AUTO_ACCEPT=0.92
# OER_MATCH_AUTO_REJECT=0.62

# ---------------------------------------------------------------------------
# LLM adjudication (optional)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OER_MATCH_LLM_MODEL=claude-sonnet-5
# OER_MATCH_LLM_MAX_PAIRS=5000
# OER_MATCH_LLM_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
# OER_NEO4J_URI=bolt://localhost:7687
# OER_NEO4J_USER=neo4j
# OER_NEO4J_PASSWORD=ownership-dev-password

# ---------------------------------------------------------------------------
# Runtime — raise the memory limit for the full national run
# ---------------------------------------------------------------------------
# OER_RUNTIME_DUCKDB_MEMORY_LIMIT=8GB
# OER_RUNTIME_DUCKDB_THREADS=8
